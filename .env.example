# Copy to .env and replace every value. Nothing here is a real credential.
#
# packages/config validates all of this at boot and reports every problem at once.
# A missing or malformed value stops the process; it never starts degraded.

NODE_ENV=development

# The application role. Refused at connect time if it is superuser or BYPASSRLS (spec 12.3).
TALLA_DATABASE_URL=postgresql://talla_app:replace-me@localhost:5432/talla
# The migration role. Never the same role as the application (spec 12.3).
TALLA_MIGRATION_DATABASE_URL=postgresql://talla_migrate:replace-me@localhost:5432/talla

# Four distinct 32 byte keys, base64. Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Reusing one key for two purposes looks tidy and turns one compromise into two.
TALLA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAE=
TALLA_INDEX_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAI=
TALLA_PHONE_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAM=
TALLA_SESSION_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQ=

# The single dedicated admin origin (spec 12.4). Never a tenant subdomain.
TALLA_ADMIN_HOST=admin.localhost:3001
# Parent domain that tenant subdomains hang from.
TALLA_STOREFRONT_ROOT_DOMAIN=localhost:3000

# S3 compatible object storage, EU Frankfurt (ADR-0013). Provider chosen at deployment.
TALLA_ASSET_ENDPOINT=http://localhost:9000
TALLA_ASSET_BUCKET=talla-assets
TALLA_ASSET_ACCESS_KEY=replace-me
TALLA_ASSET_SECRET_KEY=replace-me

# log, sms, or whatsapp. Refused as log when NODE_ENV is production: OTP codes in a
# deployment log are an authentication bypass for everyone who can read that log.
TALLA_OTP_CHANNEL=log

# Optional. The phone number scripts/seed-dev.ts grants the seeded store to, so a fresh
# clone has somebody who can sign in to the admin origin.
TALLA_SEED_OWNER_PHONE=+201000000001
