# Copy to .env.sms for the local production-shaped Compose stack. Only storefront and
# admin receive this file; migrations, seed, and jobs have no reason to hold an SMS key.
#
# These valid-shaped placeholders make any attempted delivery fail at Twilio. Replace all
# four together to exercise real delivery to an authorized test phone.
TALLA_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TALLA_TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TALLA_TWILIO_API_KEY_SECRET=replace-this-local-placeholder
TALLA_TWILIO_MESSAGING_SERVICE_SID=MG00000000000000000000000000000000
