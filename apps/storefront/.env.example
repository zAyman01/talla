# PostgreSQL application role. It must be NOSUPERUSER and NOBYPASSRLS.
TALLA_DATABASE_URL=postgresql://talla_app:replace-me@database.example:5432/talla?sslmode=require
# Used only by the migration command. Never expose it to the web process.
TALLA_MIGRATION_DATABASE_URL=postgresql://migration-role:replace-me@database.example:5432/talla?sslmode=require

# Generate each value independently with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
TALLA_PRIVACY_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64url
TALLA_PHONE_INDEX_KEY=replace-with-32-random-bytes-in-base64url
TALLA_PHONE_TOKEN_KEY=replace-with-32-random-bytes-in-base64url
TALLA_EXPERIMENT_KEY=replace-with-32-random-bytes-in-base64url
TALLA_OWNER_SESSION_KEY=replace-with-32-random-bytes-in-base64url

TALLA_PARENT_DOMAIN=talla.example
TALLA_LOCAL_SUBDOMAIN=demo
TALLA_TENANTS_JSON='{"demo":{"tenantId":"11111111-1111-4111-8111-111111111111","name":"اسم المتجر","whatsappPhone":"+201000000000","publicOrigin":"https://demo.talla.example"}}'

TALLA_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-me
TWILIO_API_KEY_SID=replace-me
TWILIO_API_KEY_SECRET=replace-me
TWILIO_MESSAGING_SERVICE_SID=replace-me

# Enable only behind an ingress that replaces X-Forwarded-For.
TALLA_TRUST_PROXY=true

# Admin is served only on this dedicated origin. Values may be HTTP only in local development.
TALLA_ADMIN_HOST=admin.talla.example
TALLA_ADMIN_ORIGIN=https://admin.talla.example
